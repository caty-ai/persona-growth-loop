[Unit]
Description=Persona Growth Loop alpha observation collector

[Service]
Type=oneshot
WorkingDirectory=__PGL_REPO__
Environment=PGL_HOME=__PGL_HOME__
Environment=PATH=__PGL_PYTHON_BIN__:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env python3 __PGL_REPO__/collectors/claude_code/collector.py --config __PGL_REPO__/config/obs-collector.json
StandardOutput=append:__PGL_HOME__/logs/collector.out.log
StandardError=append:__PGL_HOME__/logs/collector.err.log
